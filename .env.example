# RPG System.IO — variáveis de ambiente
#
# Copie este arquivo para `.env` e preencha com os valores do projeto Supabase.
# O `.env` real NÃO é versionado (ver .gitignore).
#
# Onde encontrar: Supabase → Project Settings → API
#
# ATENÇÃO: apenas chaves com prefixo VITE_ podem entrar aqui. Tudo que tem
# prefixo VITE_ é embutido no bundle do front e fica visível para qualquer
# visitante. A service_role key NUNCA deve aparecer neste arquivo nem em
# qualquer variável VITE_ — ela só existe no servidor / Edge Functions.

VITE_SUPABASE_PROJECT_ID="seu-project-id"
VITE_SUPABASE_URL="https://seu-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-publishable-key"
